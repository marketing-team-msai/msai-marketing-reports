# =====================================================================
# config.env.example  -  TEMPLATE. Real settings kept, SECRETS removed.
# =====================================================================
# Only needed to run the reports on your own machine. The scheduled
# cloud run builds this file from GitHub secrets instead.
#
# To run locally, copy this file to a new file named exactly
#   config.env
# in this same folder, then fill in the values marked REPLACE_ME. If you
# publish to Supabase only, the three MSAI_* Microsoft values are not
# needed at all.
# Everything else below is already set to the values this system runs on,
# so you should not need to change them unless the business rules change.
#
# The scripts read config.env automatically. There is nothing to edit in
# the code.
#
# SECURITY: config.env holds live credentials once filled in. Keep it on
# the machine only. Do not email it, upload it, or put it in shared or
# cloud storage. See "Credentials" in README.md for where each value
# comes from. Never commit it: .gitignore already excludes it.
# =====================================================================

# ---- Where the workbooks get published ------------------------------
# supabase    private Supabase Storage bucket. No IT dependency. Default.
# sharepoint  the Marketing SharePoint site. Needs the Microsoft app
#             registration below and its Sites.Selected grant from IT.
# both        publish to both.
PUBLISH_TARGET=supabase

# ---- HubSpot: marketing data source (SECRET token) ------------------
# Private-app token, READ scopes only:
#   crm.lists.read, crm.objects.contacts.read,
#   crm.objects.companies.read, crm.objects.deals.read
HUBSPOT_TOKEN=REPLACE_ME
# These two are HubSpot identifiers, not secrets (portal + the folder of
# "Campaign Influence" segment lists). Already set correctly:
HUBSPOT_PORTAL_ID=20335613
CAMPAIGN_INFLUENCE_FOLDER_ID=240016304
# HubSpot internal id of the "Net New Pipeline" (used by the Net New report).
# If the Net New report needs it and it is not set, get it from HubSpot.
# NET_NEW_PIPELINE_ID=

# Only include deals/contacts created on or after this date (YYYY-MM-DD):
DEALS_CREATED_SINCE=2025-06-01

# ---- Windsor.ai: ad-spend data source (SECRET key) ------------------
WINDSOR_API_KEY=REPLACE_ME
# Date window Windsor pulls. Optional; defaults to last_365d if omitted.
WINDSOR_DATE_PRESET=last_365d

# ---- SLA report thresholds: business rules, in days -----------------
# How long a lead may sit in each stage before it breaches SLA. Not
# secrets. Change these numbers to change the rule; no code change needed.
SLA_DAYS_IN_PROGRESS=14
SLA_DAYS_QUALIFIED=14
SLA_DAYS_AWAITING_SALES_QUALIFICATION=1

# ---- Microsoft 365 / SharePoint (SECRET) ----------------------------
# ONLY needed when PUBLISH_TARGET is sharepoint or both. Leave these as
# REPLACE_ME, or delete these lines, if you publish to Supabase only.
# Dedicated app registration from IT (Elevated Tech), granted WRITE
# access to the Marketing SharePoint site (Sites.Selected, APPLICATION
# permission, admin-consented). See README "Credentials".
MSAI_TENANT_ID=REPLACE_ME
MSAI_CLIENT_ID=REPLACE_ME
MSAI_CLIENT_SECRET=REPLACE_ME
# Alternative to the client secret: a delegated refresh token. Use ONE
# approach, not both. If you use the secret above, leave this blank.
# MSAI_REFRESH_TOKEN=

# ---- Supabase: history tables (SECRET service key) ------------------
# Project URL from Supabase: Settings > API > Project URL.
SUPABASE_URL=REPLACE_ME
# The service_role key, NOT the anon key. Settings > API > service_role.
# This key bypasses row-level security, so treat it like a password.
SUPABASE_SERVICE_KEY=REPLACE_ME
# Storage bucket the workbooks are written to. Created automatically,
# private. Change only if you want a different bucket name.
SUPABASE_BUCKET=reports
# How long the shareable download links printed in the log stay valid.
SUPABASE_LINK_DAYS=7

# ---- Optional overrides (leave commented unless IT tells you) --------
# Target SharePoint site and root folder are built into run_all_reports.py.
# Only set these to point at a different site or folder.
# MSAI_SITE_ID=
# MSAI_SP_ROOT=Reports/Automated Reporting
